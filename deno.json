{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task test",
    "fix": "deno fmt && deno lint --fix",
    "test": "deno test --allow-read",
    "deploy": "deno run --allow-run=git,rsync,ssh scripts/deploy.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": false,
    "proseWrap": "preserve",
    "exclude": ["site/"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
